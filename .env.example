# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whowins
DB_USER=postgres
DB_PASSWORD=changeme

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI autorizada: http://localhost:8000/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (Gmail: usar una contraseña de aplicación, no la del correo)
MAIL_USERNAME=
MAIL_PASSWORD=

FRONTEND_URL=http://localhost:5173

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Firma la cookie de sesión del handshake OAuth. Si se deja vacío se reutiliza
# JWT_SECRET. Generar igual que JWT_SECRET.
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=600

# Lista separada por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173

# "memory://" solo sirve con un único worker. En producción: redis://host:6379
RATE_LIMIT_STORAGE_URI=memory://

SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# dev | production
ENV=dev
