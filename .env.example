# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whowins
DB_USER=postgres
DB_PASSWORD=changeme

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI autorizada: http://localhost:8000/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (Gmail: usar una contraseña de aplicación, no la del correo)
MAIL_USERNAME=
MAIL_PASSWORD=

FRONTEND_URL=http://localhost:5173

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Firma la cookie de sesión del handshake OAuth. Si se deja vacío se reutiliza
# JWT_SECRET. Generar igual que JWT_SECRET.
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=600

# Lista separada por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173

# "memory://" solo sirve con un único worker. En producción: redis://host:6379
RATE_LIMIT_STORAGE_URI=memory://

SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# dev | production
ENV=dev

# Almacenamiento de objetos (MinIO en local: docker compose up -d).
# Consola de MinIO: http://localhost:9001
STORAGE_ENDPOINT_URL=http://localhost:9000
# Solo si el navegador usa otro host que el backend (deja vacío en local)
STORAGE_PUBLIC_ENDPOINT_URL=
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=whowins
STORAGE_REGION=us-east-1
STORAGE_UPLOAD_URL_EXPIRE_SECONDS=300
STORAGE_DOWNLOAD_URL_EXPIRE_SECONDS=900
STORAGE_MAX_UPLOAD_BYTES=5242880
STORAGE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
