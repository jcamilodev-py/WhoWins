# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whowins
DB_USER=postgres
DB_PASSWORD=changeme

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:8000/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (Gmail: use an app password, not the account password)
MAIL_USERNAME=
MAIL_PASSWORD=

FRONTEND_URL=http://localhost:5173

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Signs the session cookie used during the OAuth handshake. Left empty, it falls
# back to JWT_SECRET. Generate it the same way.
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=600

# Comma-separated list
CORS_ALLOWED_ORIGINS=http://localhost:5173

# "memory://" only works with a single worker. In production: redis://host:6379
RATE_LIMIT_STORAGE_URI=memory://

SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# dev | production
ENV=dev

# Object storage (MinIO locally: docker compose up -d).
# MinIO console: http://localhost:9001
STORAGE_ENDPOINT_URL=http://localhost:9000
# Only when the browser reaches storage through a different host than the
# backend does. Leave it empty locally and in any single-host deployment.
STORAGE_PUBLIC_ENDPOINT_URL=
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=whowins
STORAGE_REGION=us-east-1
STORAGE_UPLOAD_URL_EXPIRE_SECONDS=300
STORAGE_DOWNLOAD_URL_EXPIRE_SECONDS=900
STORAGE_MAX_UPLOAD_BYTES=5242880
STORAGE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
